NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Leave unset for "public" (default, required for production and
# any project shared with other apps, e.g. Lovable Cloud). Set to "dromedario"
# only on a dedicated Supabase project where you ran supabase/schema.dromedario.sql
# and exposed the "dromedario" schema in Project Settings > API.
# NEXT_PUBLIC_SUPABASE_DB_SCHEMA=dromedario
